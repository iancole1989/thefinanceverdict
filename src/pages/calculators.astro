---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Calculators" description="Personal finance calculators — budget, debt payoff, savings goal, emergency fund, retirement, and more. All free, all browser-based.">
  <section class="container-wide py-12 md:py-16">
    <h1 class="font-heading font-extrabold text-4xl md:text-5xl text-navy-deep tracking-tight">Calculators</h1>
    <p class="mt-3 text-navy-charcoal max-w-2xl">
      Free, browser-based calculators for the most common money decisions. All maths runs
      in your browser — we don't collect any of the inputs you type in.
    </p>
    <div class="mt-10 bg-canvas-subtle border border-line rounded-md p-10">
      <p class="font-heading font-bold text-xl text-navy-deep mb-2">First calculators publishing in month 2</p>
      <p class="text-navy-charcoal max-w-md">
        Planned launch set: budget planner, debt payoff, savings goal, emergency fund target,
        retirement gap, compound interest, mortgage payoff acceleration.
      </p>
    </div>
  </section>
</BaseLayout>
