---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const now = Date.now();
const comparisons = (
  await getCollection(
    "articles",
    ({ data }) =>
      !data.draft &&
      data.publishedAt.valueOf() <= now &&
      data.isComparison,
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Comparisons" description="Head-to-head comparisons of personal finance tools — YNAB vs Monarch, TurboTax vs FreeTaxUSA, and more.">
  <section class="container-wide py-12 md:py-16">
    <h1 class="font-heading font-extrabold text-4xl md:text-5xl text-navy-deep tracking-tight">Comparisons</h1>
    <p class="mt-3 text-navy-charcoal max-w-2xl">
      Head-to-head verdicts on the personal finance tools people are actually choosing
      between. We pick a side and explain who picks which.
    </p>
    {comparisons.length === 0 ? (
      <p class="mt-10 text-caution">First comparisons publishing this week.</p>
    ) : (
      <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {comparisons.map((a) => (
          <a href={`/${a.slug}/`} class="group block bg-canvas-white border border-line rounded-md p-5 hover:border-gold hover:shadow-sm transition-all">
            <h3 class="font-heading font-bold text-lg text-navy-deep group-hover:text-gold-hover">{a.data.title}</h3>
            <p class="mt-2 text-sm text-navy-charcoal leading-relaxed line-clamp-3">{a.data.description}</p>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
